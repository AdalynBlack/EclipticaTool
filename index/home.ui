<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkWindow" id="window">
    <property name="title" translatable="yes">Open Tool for Ecliptica</property>
    <property name="name">beginning-lobby</property>
    <property name="resizable">False</property>
    <property name="default-width">64</property>
    <property name="default-height">64</property>
    <property name="decorated">False</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkButton" id="infoButton">
                <property name="name">info-button</property>
              </object>
            </child>
          </object>
          <object class="GtkBox">
            <child>
              <object class="GtkImage" id="bossIcon">
                <property name="name">boss-box</property>
                <property name="pixel_size">64</property>
                <property name="tooltip_text" translatable="yes">No Active Boss</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <child>
                  <object class="GtkLabel" id="bossTargetLabel">
                    <property name="name">target-other</property>
                    <style>
                      <class name="boss-target"/>
                    </style>
                    <property name="label" translatable="yes">No Target</property>
                    <property name="halign">start</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="targetLabel">
                    <property name="name">target-other</property>
                    <style>
                      <class name="target"/>
                    </style>
                    <property name="label" translatable="yes">No Target</property>
                    <property name="halign">start</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="damageLabel">
            <property name="name">subtext</property>
            <property name="label" translatable="yes">No Damage Dealt</property>
            <property name="halign">start</property>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <child>
              <object class="GtkLabel" id="stageDamageLabel">
                <property name="name">stage-damage</property>
                <property name="label">0</property>
                <property name="xalign">0.0</property>
                <property name="tooltip_text" translatable="yes">Stage Damage (Partially Implemented)</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="bossDamageLabel">
                <property name="name">boss-damage</property>
                <property name="label">?</property>
                <property name="xalign">0.0</property>
                <property name="tooltip_text" translatable="yes">Boss Damage (Unimplemented)</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="phaseLabel">
            <property name="name">phase</property>
            <property name="label" translatable="yes">Phase Unknown</property>
            <property name="halign">start</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
